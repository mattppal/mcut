{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/codemods/*.ts", "scripts/standards/*.ts", "scripts/fixtures/*.ts", "scripts/agent-e2e/*.test.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["@arethetypeswrong/cli"]
    },
    "apps/desktop": {
      "entry": ["src/*.test.ts", "scripts/*.ts", "electron-builder.ts"],
      "ignoreBinaries": ["codesign"]
    },
    "apps/studio": {
      "entry": ["registry/mcut/**/*.{ts,tsx}", "scripts/*.ts"],
      "ignore": ["components/ui/**", "components/kibo-ui/**"],
      "ignoreDependencies": ["@types/color", "mcut-editing-skill"],
      "ignoreBinaries": ["ffmpeg"]
    },
    "apps/web": {
      "entry": ["worker/index.ts", "source.config.ts"],
      "ignore": ["components/mdx.tsx", "lib/hugeicons.tsx"]
    },
    "skills/mcut-editing": {
      "entry": ["tools/*.ts"]
    }
  }
}
