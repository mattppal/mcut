{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 160,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "apps/studio/public",
    "apps/studio/components/ui",
    "apps/studio/components/kibo-ui",
    "apps/web/.source",
    "apps/web/next-env.d.ts",
    "dist",
    "node_modules",
    "skills/mcut-editing/references",
    ".changeset",
    ".cursor",
    ".github",
    "docs",
    "*.md",
    "*.mdx",
    "knip.json",
    "turbo.json",
    "apps/web/components/signup-form.tsx",
    "apps/studio/registry/mcut/persistence.ts",
    "apps/studio/registry/mcut/style-fields.tsx",
    "scripts/standards/measure.ts"
  ]
}
