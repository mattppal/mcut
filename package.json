{
  "name": "mcut",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*",
    "skills/*"
  ],
  "scripts": {
    "dev": "bun run scripts/mcut-local-dev.ts dev",
    "dev:web": "turbo run dev --filter=mcut-web",
    "desktop:check": "bun run scripts/desktop-check.ts",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "check:format": "oxfmt --check",
    "lint:oxlint": "oxlint --deny-warnings",
    "smoke:packages": "bun run scripts/smoke-packages.ts",
    "fixtures": "bun scripts/fixtures/generate-media.ts --mutate",
    "fuzz:media": "bun run fixtures && bun run --filter @mcut/media fuzz:media",
    "fuzz:media:e2e": "bun run fixtures && bun run --filter mcut-studio fuzz:media",
    "fuzz:mcp:bridge": "bun scripts/agent-e2e/fuzz-bridge.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run release:check && bun run release:publish",
    "release:github-packages": "bun run scripts/publish-github-packages.ts",
    "package:metadata": "bun run scripts/validate-package-metadata.ts",
    "package:json-lint": "npmPkgJsonLint --configFile .npmpackagejsonlintrc.json packages --quiet",
    "package:lint": "bun run package:metadata && bun run package:json-lint && bun run scripts/package-lint.ts",
    "release:check": "bun run build && bun run typecheck && bun run test && bun run lint && bun run smoke:packages && bun run package:lint && bun run standards && bun run docs:coverage && bun run check:format",
    "release:publish": "changeset publish",
    "standards": "bun scripts/standards/measure.ts --base origin/main --quiet",
    "standards:strip": "bun scripts/standards/strip-comments.ts",
    "docs:coverage": "bun scripts/standards/docs-coverage.ts",
    "knip": "knip"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.3",
    "@changesets/changelog-github": "0.7.0",
    "@changesets/cli": "2.31.0",
    "@mcut/mcp-server": "workspace:*",
    "@mcut/timeline": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.21.0",
    "@types/bun": "1.3.14",
    "knip": "6.16.1",
    "npm-package-json-lint": "10.4.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "pkg-pr-new": "0.0.75",
    "publint": "0.3.21",
    "tsdown": "0.22.2",
    "turbo": "2.9.18",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "description": "Open source video editing SDK for TypeScript apps.",
  "author": "Matt Palmer",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattppal/mcut.git"
  },
  "bugs": {
    "url": "https://github.com/mattppal/mcut/issues"
  },
  "homepage": "https://github.com/mattppal/mcut#readme",
  "keywords": [
    "mcut",
    "video",
    "editing",
    "sdk",
    "typescript",
    "bun"
  ]
}
